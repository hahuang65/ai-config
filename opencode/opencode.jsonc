{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "formatter": {
    "rubocop": {
      "disabled": true
    }
  },
  "permission": {
    "bash": {
      "*": "ask",
      "cat *": "allow",
      "file *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "brew --cache *": "allow",
      "brew cat *": "allow",
      "brew list": "allow",
      "brew list *": "allow",
      "brew info *": "allow",
      "npm list": "allow",
      "npm list *": "allow",
      "mkdir -p docs/claude": "allow",
      "mkdir -p docs/claude/*": "allow",
      "mkdir -p */docs/claude": "allow",
      "mkdir -p */docs/claude/*": "allow",
      "mkdir -p docs/adr": "allow",
      "mkdir -p docs/adr/*": "allow",
      "mkdir -p */docs/adr": "allow",
      "mkdir -p */docs/adr/*": "allow",
      "open */docs/claude/*.html": "allow",
      "open docs/claude/*.html": "allow",
      "xdg-open */docs/claude/*.html": "allow",
      "xdg-open docs/claude/*.html": "allow",
      "aws * describe-*": "allow",
      "aws * get-*": "allow",
      "aws * list-*": "allow",
      "curl -L *": "allow",
      "curl -O *": "allow",
      "curl -o *": "allow",
      "curl -s *": "allow",
      "curl -sL *": "allow",
      "curl -sS *": "allow",
      "docker compose *": "allow",
      "git checkout *": "allow",
      "git fetch *": "allow",
      "git pull *": "allow",
      "git stash *": "allow",
      "git switch *": "allow",
      "go build *": "allow",
      "go get *": "allow",
      "go mod tidy": "allow",
      "go vet *": "allow",
      "grep *handoff-*": "allow",
      "jq *": "allow",
      "ls *handoff-*": "allow",
      "rspec *": "allow",
      "mise x -- rspec *": "allow",
      "bundle exec rspec *": "allow",
      "mise x -- bundle exec rspec *": "allow",
      "rake test": "allow",
      "mise x -- rake test": "allow",
      "bundle exec rake test": "allow",
      "mise x -- bundle exec rake test": "allow",
      "rake test:*": "allow",
      "mise x -- rake test:*": "allow",
      "bundle exec rake test:*": "allow",
      "mise x -- bundle exec rake test:*": "allow",
      "rails test": "allow",
      "mise x -- rails test": "allow",
      "bundle exec rails test": "allow",
      "mise x -- bundle exec rails test": "allow",
      "rails test:*": "allow",
      "mise x -- rails test:*": "allow",
      "bundle exec rails test:*": "allow",
      "mise x -- bundle exec rails test:*": "allow",
      "rails data:*": "allow",
      "mise x -- rails data:*": "allow",
      "bundle exec rails data:*": "allow",
      "mise x -- bundle exec rails data:*": "allow",
      "rails assets:*": "allow",
      "mise x -- rails assets:*": "allow",
      "bundle exec rails assets:*": "allow",
      "mise x -- bundle exec rails assets:*": "allow",
      "rails db:*": "allow",
      "mise x -- rails db:*": "allow",
      "bundle exec rails db:*": "allow",
      "mise x -- bundle exec rails db:*": "allow",
      "rails spec": "allow",
      "mise x -- rails spec": "allow",
      "bundle exec rails spec": "allow",
      "mise x -- bundle exec rails spec": "allow",
      "rails spec:*": "allow",
      "mise x -- rails spec:*": "allow",
      "bundle exec rails spec:*": "allow",
      "mise x -- bundle exec rails spec:*": "allow",
      "rubocop *": "allow",
      "mise x -- rubocop *": "allow",
      "bundle exec rubocop *": "allow",
      "mise x -- bundle exec rubocop *": "allow",
      "black *": "allow",
      "mypy *": "allow",
      "pip list *": "allow",
      "pytest *": "allow",
      "python -m pytest *": "allow",
      "ruff *": "allow",
      "terraform fmt *": "allow",
      "terraform init *": "allow",
      "terraform plan *": "allow",
      "terraform show *": "allow",
      "terraform validate *": "allow",
      "aws * delete-*": "deny",
      "aws * terminate-*": "deny",
      "aws ec2 terminate-instances *": "deny",
      "curl * | bash*": "deny",
      "curl * | node*": "deny",
      "curl * | perl*": "deny",
      "curl * | python*": "deny",
      "curl * | ruby*": "deny",
      "curl * | sh*": "deny",
      "curl * | sudo*": "deny",
      "curl * | zsh*": "deny",
      "git clean -f *": "deny",
      "git push --force *": "deny",
      "git push -f *": "deny",
      "git reset --hard *": "deny",
      "make apply": "deny",
      "make deploy*": "deny",
      "make push*": "deny",
      "rm *": "deny",
      "rm -rf *": "deny",
      "echo *>*": "deny",
      "echo *>>*": "deny",
      "terraform apply": "deny",
      "terraform apply *": "deny",
      "terraform destroy *": "deny",
      "git add *": "ask",
      "git clean *": "ask",
      "git commit *": "ask"
    },
    "read": {
      "*": "allow",
      "CONTEXT.md": "allow",
      "docs/adr/**": "allow",
      "*/docs/adr/**": "allow",
      "docs/claude/**": "allow",
      "*/docs/claude/**": "allow",
      "~/.claude/*": "allow",
      "~/.claude/skills/**": "allow",
      "**/handoff-*.md": "allow",
      "**/.aws/credentials": "deny",
      "**/credentials*": "deny",
      "*.secrets.*": "deny",
      "*.env": "ask",
      "*.env.*": "ask"
    },
    "write": {
      "*": "ask",
      "CONTEXT.md": "allow",
      "docs/adr/**": "allow",
      "*/docs/adr/**": "allow",
      "docs/claude/**": "allow",
      "*/docs/claude/**": "allow"
    },
    "edit": {
      "*": "ask",
      "CONTEXT.md": "allow",
      "docs/adr/**": "allow",
      "*/docs/adr/**": "allow",
      "docs/claude/**": "allow",
      "*/docs/claude/**": "allow"
    },
    "task": {
      "*": "ask",
      "explore": "allow",
      "plan": "allow"
    },
    "external_directory": {
      "*": "ask",
      "~/.claude/**": "allow",
      "~/.config/opencode/**": "allow",
      "/tmp/**": "allow"
    },
    "glob": "allow",
    "glob *": "allow",
    "grep": "allow",
    "grep *": "allow",
    "list": "allow",
    "skill": "allow",
    "todoread": "allow",
    "todowrite": "allow",
    "webfetch": "allow",
    "websearch": "allow"
  }
}
