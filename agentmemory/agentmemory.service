[Unit]
Description=agentmemory persistent memory service
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/.dotfiles/ai
ExecStart=%h/.local/share/mise/shims/agentmemory
ExecStop=%h/.local/share/mise/shims/agentmemory stop
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
