{
  "env": {
    "DISABLE_AUTOUPDATER": "1"
  },
  "permissions": {
    "allow": [
      "Bash(mkdir -p docs/claude)",
      "Bash(mkdir -p docs/claude/*)",
      "Bash(mkdir -p */docs/claude)",
      "Bash(mkdir -p */docs/claude/*)",
      "Read(CONTEXT.md)",
      "Edit(CONTEXT.md)",
      "Write(CONTEXT.md)",
      "Bash(mkdir -p docs/adr)",
      "Bash(mkdir -p docs/adr/*)",
      "Bash(mkdir -p */docs/adr)",
      "Bash(mkdir -p */docs/adr/*)",
      "Read(docs/adr/**)",
      "Read(*/docs/adr/**)",
      "Edit(docs/adr/**)",
      "Edit(*/docs/adr/**)",
      "Write(docs/adr/**)",
      "Write(*/docs/adr/**)",
      "Read(docs/claude/**)",
      "Read(*/docs/claude/**)",
      "Edit(docs/claude/**)",
      "Edit(*/docs/claude/**)",
      "Write(docs/claude/**)",
      "Write(*/docs/claude/**)",
      "Bash(open */docs/claude/*.html)",
      "Bash(open docs/claude/*.html)",
      "Bash(xdg-open */docs/claude/*.html)",
      "Bash(xdg-open docs/claude/*.html)",
      "Bash(aws * describe-*)",
      "Bash(aws * get-*)",
      "Bash(aws * list-*)",
      "Bash(curl -L *)",
      "Bash(curl -O *)",
      "Bash(curl -o *)",
      "Bash(curl -s *)",
      "Bash(curl -sL *)",
      "Bash(curl -sS *)",
      "Bash(docker compose *)",
      "Bash(git checkout *)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(git stash *)",
      "Bash(git switch *)",
      "Bash(go build *)",
      "Bash(go get *)",
      "Bash(go mod tidy)",
      "Bash(go vet *)",
      "Bash(grep *handoff-*)",
      "Bash(jq *)",
      "Bash(ls *handoff-*)",
      "Bash(rspec *)",
      "Bash(mise x -- rspec *)",
      "Bash(bundle exec rspec *)",
      "Bash(mise x -- bundle exec rspec *)",
      "Bash(rake test)",
      "Bash(mise x -- rake test)",
      "Bash(bundle exec rake test)",
      "Bash(mise x -- bundle exec rake test)",
      "Bash(rake test:*)",
      "Bash(mise x -- rake test:*)",
      "Bash(bundle exec rake test:*)",
      "Bash(mise x -- bundle exec rake test:*)",
      "Bash(rails test)",
      "Bash(mise x -- rails test)",
      "Bash(bundle exec rails test)",
      "Bash(mise x -- bundle exec rails test)",
      "Bash(rails test:*)",
      "Bash(mise x -- rails test:*)",
      "Bash(bundle exec rails test:*)",
      "Bash(mise x -- bundle exec rails test:*)",
      "Bash(rails data:*)",
      "Bash(mise x -- rails data:*)",
      "Bash(bundle exec rails data:*)",
      "Bash(mise x -- bundle exec rails data:*)",
      "Bash(rails assets:*)",
      "Bash(mise x -- rails assets:*)",
      "Bash(bundle exec rails assets:*)",
      "Bash(mise x -- bundle exec rails assets:*)",
      "Bash(rails db:*)",
      "Bash(mise x -- rails db:*)",
      "Bash(bundle exec rails db:*)",
      "Bash(mise x -- bundle exec rails db:*)",
      "Bash(rails spec)",
      "Bash(mise x -- rails spec)",
      "Bash(bundle exec rails spec)",
      "Bash(mise x -- bundle exec rails spec)",
      "Bash(rails spec:*)",
      "Bash(mise x -- rails spec:*)",
      "Bash(bundle exec rails spec:*)",
      "Bash(mise x -- bundle exec rails spec:*)",
      "Bash(rubocop *)",
      "Bash(mise x -- rubocop *)",
      "Bash(bundle exec rubocop *)",
      "Bash(mise x -- bundle exec rubocop *)",
      "Bash(black *)",
      "Bash(mypy *)",
      "Bash(pip list *)",
      "Bash(pytest *)",
      "Bash(python -m pytest *)",
      "Bash(ruff *)",
      "Bash(terraform fmt *)",
      "Bash(terraform init *)",
      "Bash(terraform plan *)",
      "Bash(terraform show *)",
      "Bash(terraform validate *)",
      "Read(~/.claude/*)",
      "Read(~/.claude/skills/**)",
      "Glob(~/.claude/skills/**)",
      "Grep(~/.claude/skills/**)",
      "Read(**/handoff-*.md)",
      "Search",
      "Task(Explore)",
      "Task(Plan)",
      "WebFetch",
      "WebSearch"
    ],
    "deny": [
      "Bash(aws * delete-*)",
      "Bash(aws * terminate-*)",
      "Bash(aws ec2 terminate-instances *)",
      "Bash(curl * | bash*)",
      "Bash(curl * | node*)",
      "Bash(curl * | perl*)",
      "Bash(curl * | python*)",
      "Bash(curl * | ruby*)",
      "Bash(curl * | sh*)",
      "Bash(curl * | sudo*)",
      "Bash(curl * | zsh*)",
      "Bash(git clean -f *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(make apply)",
      "Bash(make deploy*)",
      "Bash(make push*)",
      "Bash(rm *)",
      "Bash(rm -rf *)",
      "Bash(echo *>*)",
      "Bash(echo *>>*)",
      "Bash(terraform apply)",
      "Bash(terraform apply *)",
      "Bash(terraform destroy *)",
      "Read(**/.aws/credentials)",
      "Read(**/credentials*)",
      "Read(*.secrets.*)"
    ],
    "ask": [
      "Bash(git add *)",
      "Bash(git clean *)",
      "Bash(git commit *)",
      "Read(*.env)",
      "Read(*.env.*)"
    ],
    "additionalDirectories": [
      "~/.claude",
      "/tmp"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.dotfiles/ai/scripts/hooks/deny-curl-to-interpreter.sh",
            "if": "Bash(curl *)",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "lua-lsp@claude-plugins-official": true,
    "ruby-skills@ruby-skills": true,
    "ruby-lsp@ruby-skills": true,
    "astral@astral-sh": true,
    "bash-language-server@claude-code-lsps": true,
    "terraform-ls@claude-code-lsps": true,
    "gopls-lsp@claude-plugins-official": true
  }
}
