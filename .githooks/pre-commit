#!/usr/bin/env bash
set -euo pipefail

REPO_DIR="$(git rev-parse --show-toplevel)"

# Git exports repository-local variables to hooks, including GIT_INDEX_FILE.
# Clear them so tests that create nested repositories discover their own state.
while IFS= read -r variable; do
  unset "$variable"
done < <(git rev-parse --local-env-vars)

# Fail closed if the native package's verification gate is unavailable.
if [[ ! -f "$REPO_DIR/Makefile" ]]; then
  printf 'No native package verification gate in %s\n' "$REPO_DIR" >&2
  exit 1
fi
make -s -C "$REPO_DIR" lint test
